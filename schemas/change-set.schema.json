{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://taichios.dev/schemas/change-set.schema.json",
  "title": "TaiChiOS Change Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "organizationId",
    "actorId",
    "mode",
    "state",
    "source",
    "effects",
    "verification"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["managed-file", "profile", "plugin", "system-update"] },
    "organizationId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["guarded", "creator", "yolo"] },
    "state": {
      "enum": [
        "proposed",
        "resolved",
        "authorized",
        "staged",
        "activated",
        "verified",
        "committed",
        "failed",
        "rolled-back",
        "rollback-failed"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "sha256"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "path"],
        "properties": {
          "operation": { "enum": ["create", "replace", "remove"] },
          "path": { "type": "string", "pattern": "^/" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "enum": ["file-snapshot", "profile-link", "deployment"] },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "failureReason": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "state": { "const": "committed" } }
      },
      "then": {
        "required": ["rollback"],
        "properties": {
          "verification": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "state": { "enum": ["failed", "rollback-failed"] } }
      },
      "then": { "required": ["failureReason"] }
    }
  ]
}
