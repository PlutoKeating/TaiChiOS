{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://taichios.dev/schemas/control-plane.schema.json",
  "title": "TaiChiOS control-plane contracts",
  "definitions": {
    "Organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ownerId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ownerId": { "type": "string", "minLength": 1 }
      }
    },
    "Principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["human-user", "working-agent", "service-principal"]
        },
        "ownerId": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "enum": ["working-agent", "service-principal"] }
            }
          },
          "then": { "required": ["ownerId"] }
        }
      ]
    },
    "CapabilityGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "grantorId", "granteeId", "capabilities"],
      "properties": {
        "organizationId": { "type": "string", "minLength": 1 },
        "grantorId": { "type": "string", "minLength": 1 },
        "granteeId": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "resource": { "type": "string", "minLength": 1 }
      }
    },
    "OwnedResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "organizationId", "ownerId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["workspace", "long-running-goal"] },
        "organizationId": { "type": "string", "minLength": 1 },
        "ownerId": { "type": "string", "minLength": 1 }
      }
    },
    "SecretReference": {
      "description": "A reference to a stored secret. Credential material is never part of this contract.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "SecretGrant": {
      "description": "An opaque, audience-scoped, single-use credential grant.",
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "organizationId", "principalId", "secretId", "audience", "expiresAt"],
      "properties": {
        "token": { "type": "string", "minLength": 1 },
        "organizationId": { "type": "string", "minLength": 1 },
        "principalId": { "type": "string", "minLength": 1 },
        "secretId": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "ProviderInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "principalId", "model", "input", "mode"],
      "properties": {
        "organizationId": { "type": "string", "minLength": 1 },
        "principalId": { "type": "string", "minLength": 1 },
        "providerId": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "input": { "type": "string" },
        "mode": { "enum": ["guarded", "creator", "yolo"] },
        "confirmed": { "type": "boolean" }
      }
    },
    "AuditRecord": {
      "description": "A secret-free attribution record.",
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "principalId", "action", "resource", "outcome", "mode", "timestamp"],
      "properties": {
        "organizationId": { "type": "string", "minLength": 1 },
        "principalId": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["allowed", "denied", "failed"] },
        "mode": { "enum": ["guarded", "creator", "yolo"] },
        "reason": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  }
}
