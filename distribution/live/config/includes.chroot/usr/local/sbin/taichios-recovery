#!/bin/sh
set -eu

ACTION=${1:-}
shift || true
ROOT=
if test "${1:-}" = --root; then
  ROOT=${2:?missing managed root}
  shift 2
fi
if test -n "$ROOT"; then
  case "$ROOT" in /*) ;; *) echo 'managed root must be absolute' >&2; exit 2;; esac
  ROOT=$(CDPATH= cd -- "$ROOT" && pwd -P)
  test "$ROOT" != / || ROOT=
fi

case "$ACTION" in
  disable-profile)
    ACCOUNT=${1:?missing account}
    PROFILE=${2:?missing profile}
    case "$ACCOUNT:$PROFILE" in *[!A-Za-z0-9._:-]*|:|*:) echo 'invalid account or profile' >&2; exit 2;; esac
    USER_HOME=$(awk -F: -v account="$ACCOUNT" '$1 == account { print $6 }' "${ROOT}/etc/passwd")
    test -n "$USER_HOME" || { echo "account not found: $ACCOUNT" >&2; exit 1; }
    PROFILE_PATH="${ROOT}${USER_HOME}/.dsh/profiles/$PROFILE"
    test -d "$PROFILE_PATH" || { echo "profile not found: $PROFILE" >&2; exit 1; }
    test ! -e "$PROFILE_PATH.disabled" || { echo "disabled profile already exists: $PROFILE" >&2; exit 1; }
    mv "$PROFILE_PATH" "$PROFILE_PATH.disabled"
    ;;
  rollback-last)
    if test -n "$ROOT"; then
      exec /usr/local/sbin/taichios-change rollback --root "$ROOT" --last
    fi
    exec /usr/local/sbin/taichios-change rollback --last
    ;;
  verify)
    VERIFY_ROOT=${ROOT:-/}
    MANIFEST="$VERIFY_ROOT/usr/share/taichios/recovery/trusted-files.sha256"
    test -f "$MANIFEST" || { echo 'trusted Recovery manifest is missing' >&2; exit 1; }
    (cd "$VERIFY_ROOT" && sha256sum -c usr/share/taichios/recovery/trusted-files.sha256)
    ;;
  enter)
    test -z "$ROOT" || { echo 'cannot isolate a target inside an offline root' >&2; exit 2; }
    test "${1:-}" = --yes || { echo 'entering Recovery requires --yes' >&2; exit 2; }
    test "$(id -u)" -eq 0 || { echo 'entering Recovery requires root' >&2; exit 1; }
    exec systemctl isolate taichios-recovery.target
    ;;
  *)
    echo 'usage: taichios-recovery disable-profile [--root ROOT] ACCOUNT PROFILE | rollback-last [--root ROOT] | verify [--root ROOT] | enter --yes' >&2
    exit 2
    ;;
esac
