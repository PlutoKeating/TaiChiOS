#!/bin/sh
set -eu

DISK=
CONFIRMED=false
while test "$#" -gt 0; do
  case "$1" in
    --disk) DISK=${2:?missing disk}; shift 2 ;;
    --yes) CONFIRMED=true; shift ;;
    *) echo "usage: taichios-install --disk DEVICE --yes" >&2; exit 2 ;;
  esac
done

test "$(id -u)" -eq 0 || { echo "installer must run as root" >&2; exit 1; }
test "$CONFIRMED" = true || { echo "refusing destructive install without --yes" >&2; exit 2; }
test -b "$DISK" || { echo "not a block device: $DISK" >&2; exit 1; }
test -f /run/live/medium/live/filesystem.squashfs || { echo "not running from the TaiChiOS live medium" >&2; exit 1; }
test "$(blockdev --getsize64 "$DISK")" -ge 6442450944 || { echo "target must be at least 6 GiB" >&2; exit 1; }
if lsblk -nrpo MOUNTPOINT "$DISK" | grep -q '/'; then
  echo "refusing to erase a disk with mounted filesystems: $DISK" >&2
  exit 1
fi

case "$DISK" in
  *[0-9]) PART_PREFIX=${DISK}p ;;
  *) PART_PREFIX=$DISK ;;
esac
BIOS_PART=${PART_PREFIX}1
EFI_PART=${PART_PREFIX}2
ROOT_PART=${PART_PREFIX}3
TARGET_ROOT=$(mktemp -d -t taichios-target.XXXXXX)
MOUNTED=false

cleanup() {
  if test "$MOUNTED" = true; then
    umount -R "$TARGET_ROOT" 2>/dev/null || true
  fi
  rmdir "$TARGET_ROOT" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

wipefs --all "$DISK"
parted --script "$DISK" \
  mklabel gpt \
  mkpart BIOS 1MiB 3MiB \
  set 1 bios_grub on \
  mkpart ESP fat32 3MiB 259MiB \
  set 2 esp on \
  mkpart ROOT ext4 259MiB 100%
partprobe "$DISK"
udevadm settle
mkfs.vfat -F 32 -n TAICHI_EFI "$EFI_PART"
mkfs.ext4 -F -L taichios-root "$ROOT_PART"

mount "$ROOT_PART" "$TARGET_ROOT"
MOUNTED=true
mkdir -p "$TARGET_ROOT/boot/efi"
mount "$EFI_PART" "$TARGET_ROOT/boot/efi"
unsquashfs -f -d "$TARGET_ROOT" /run/live/medium/live/filesystem.squashfs

ROOT_UUID=$(blkid -s UUID -o value "$ROOT_PART")
EFI_UUID=$(blkid -s UUID -o value "$EFI_PART")
cat > "$TARGET_ROOT/etc/fstab" <<EOF
UUID=$ROOT_UUID / ext4 defaults 0 1
UUID=$EFI_UUID /boot/efi vfat umask=0077 0 1
EOF
printf '%s\n' taichios > "$TARGET_ROOT/etc/hostname"
cat > "$TARGET_ROOT/etc/hosts" <<EOF
127.0.0.1 localhost
127.0.1.1 taichios
::1 localhost ip6-localhost ip6-loopback
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
EOF
rm -f "$TARGET_ROOT/etc/systemd/system/multi-user.target.wants/taichios-boot-ready.service"

mount --rbind /dev "$TARGET_ROOT/dev"
mount --make-rslave "$TARGET_ROOT/dev"
mount -t proc proc "$TARGET_ROOT/proc"
mount -t sysfs sys "$TARGET_ROOT/sys"
mount --rbind /run "$TARGET_ROOT/run"
mount --make-rslave "$TARGET_ROOT/run"

chroot "$TARGET_ROOT" /bin/sh -eu <<EOF
systemctl disable live-config.service taichios-auto-install.service taichios-boot-ready.service
getent passwd taichi >/dev/null || useradd --create-home --shell /usr/local/bin/taichios-shell taichi
getent passwd creator >/dev/null || useradd --create-home --shell /usr/local/bin/taichios-shell creator
printf 'taichi:taichi\ncreator:creator\n' | chpasswd
usermod -a -G sudo taichi
taichios-prepare-user taichi
taichios-prepare-user creator
grub-install --target=i386-pc --recheck '$DISK'
grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=TaiChiOS --removable --no-nvram --recheck
update-grub
systemctl enable taichios-first-boot.service taichios-mock-provider.service taichios-harness@taichi.service taichios-harness@creator.service taichios-previous-rollback.service getty@tty1.service serial-getty@ttyS0.service
EOF

install -d -m 0750 "$TARGET_ROOT/var/lib/taichios/deployments/initial" "$TARGET_ROOT/var/lib/taichios/changes"
printf '{"deployment":"initial","state":"known-good","rootUuid":"%s"}\n' "$ROOT_UUID" > "$TARGET_ROOT/var/lib/taichios/deployments/initial/manifest.json"
ln -s initial "$TARGET_ROOT/var/lib/taichios/deployments/current"
ln -s initial "$TARGET_ROOT/var/lib/taichios/deployments/previous"
sync
echo "TaiChiOS installed to $DISK"
