[Unit]
Description=Validate TaiChiOS Harness profile for %i
After=local-fs.target taichios-mock-provider.service
Wants=taichios-mock-provider.service

[Service]
Type=notify
ExecStart=/usr/local/libexec/taichios-harness-supervisor %i
Restart=on-failure
RestartSec=5s
WatchdogSec=45s

[Install]
WantedBy=multi-user.target
