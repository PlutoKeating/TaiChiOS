#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
LIVE_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
REPO_DIR=$(CDPATH= cd -- "$LIVE_DIR/../.." && pwd)
ARTIFACT_DIR="$REPO_DIR/artifacts/live"
IMAGE_NAME=taichios-0.1-amd64.hybrid.iso
SOURCE_IMAGE_NAME=taichios-0.1-source.iso
SOURCE_CONTENTS_NAME=source.contents
IMAGE_BASE=${IMAGE_NAME%.hybrid.iso}
export SOURCE_DATE_EPOCH=1787097600

cd "$LIVE_DIR"
"$SCRIPT_DIR/stage-runtime"
lb build noauto "$@"

test -f "$IMAGE_NAME"
mkdir -p "$ARTIFACT_DIR"
rm -f \
  "$ARTIFACT_DIR/$IMAGE_NAME" \
  "$ARTIFACT_DIR/$SOURCE_IMAGE_NAME" \
  "$ARTIFACT_DIR/$SOURCE_CONTENTS_NAME" \
  "$ARTIFACT_DIR/$IMAGE_NAME.sha256" \
  "$ARTIFACT_DIR/SHA256SUMS" \
  "$ARTIFACT_DIR/binary.packages" \
  "$ARTIFACT_DIR/chroot.packages.install" \
  "$ARTIFACT_DIR/chroot.packages.live" \
  "$ARTIFACT_DIR/build-environment.txt" \
  "$ARTIFACT_DIR/release-metadata.json"
cp "$IMAGE_NAME" "$ARTIFACT_DIR/$IMAGE_NAME"

if test -f "$SOURCE_IMAGE_NAME"; then
  cp "$SOURCE_IMAGE_NAME" "$ARTIFACT_DIR/$SOURCE_IMAGE_NAME"
  LC_ALL=C xorriso -indev "$SOURCE_IMAGE_NAME" -find / -type f -exec echo -- 2>/dev/null \
    > "$ARTIFACT_DIR/$SOURCE_CONTENTS_NAME"
fi

if test -f "$IMAGE_BASE.packages"; then
  cp "$IMAGE_BASE.packages" "$ARTIFACT_DIR/binary.packages"
fi

for MANIFEST_NAME in chroot.packages.install chroot.packages.live; do
  if test -f "$MANIFEST_NAME"; then
    cp "$MANIFEST_NAME" "$ARTIFACT_DIR/$MANIFEST_NAME"
  fi
done

(
  cd "$ARTIFACT_DIR"
  sha256sum "$IMAGE_NAME" > "$IMAGE_NAME.sha256"
)

echo "TaiChiOS image: $ARTIFACT_DIR/$IMAGE_NAME"
