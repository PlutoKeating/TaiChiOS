#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
LIVE_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
REPO_DIR=$(CDPATH= cd -- "$LIVE_DIR/../.." && pwd)
ARTIFACT_DIR="$REPO_DIR/artifacts/live"
IMAGE_NAME=taichios-0.1-amd64.hybrid.iso
IMAGE_BASE=${IMAGE_NAME%.hybrid.iso}
export SOURCE_DATE_EPOCH=1787097600

cd "$LIVE_DIR"
"$SCRIPT_DIR/stage-runtime"
lb build noauto "$@"

test -f "$IMAGE_NAME"
mkdir -p "$ARTIFACT_DIR"
cp "$IMAGE_NAME" "$ARTIFACT_DIR/$IMAGE_NAME"

if test -f "$IMAGE_BASE.packages"; then
  cp "$IMAGE_BASE.packages" "$ARTIFACT_DIR/binary.packages"
fi

for MANIFEST_NAME in chroot.packages.install chroot.packages.live; do
  if test -f "$MANIFEST_NAME"; then
    cp "$MANIFEST_NAME" "$ARTIFACT_DIR/$MANIFEST_NAME"
  fi
done

(
  cd "$ARTIFACT_DIR"
  sha256sum "$IMAGE_NAME" > "$IMAGE_NAME.sha256"
)

echo "TaiChiOS image: $ARTIFACT_DIR/$IMAGE_NAME"
