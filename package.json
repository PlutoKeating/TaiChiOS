{
  "name": "@taichios/workspace",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "TaiChiOS — a bootable, agent-native Debian derivative built around Cordis and DeepSeek Harness",
  "packageManager": "yarn@4.14.1",
  "workspaces": [
    "external/*",
    "packages/*",
    "vendor/cordis/packages/*"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "lint": "eslint --cache",
    "install:runtime": "cd distribution/runtime && corepack pnpm install --frozen-lockfile",
    "compat:runtime": "node tools/verify-runtime-compatibility.mjs",
    "compat:cordis": "node tools/verify-vendored-cordis.mjs",
    "compat:live": "node tools/verify-debian-live.mjs",
    "install:live-build": "tools/install-live-build.sh",
    "build:live": "sudo distribution/live/auto/config && sudo distribution/live/auto/build",
    "build:release": "sudo distribution/live/auto/config --source true --apt-source-archives true && sudo distribution/live/auto/build",
    "prepare:release": "node tools/prepare-release-artifacts.mjs",
    "clean:live": "sudo distribution/live/auto/clean",
    "test:live": "tools/test-live-boot.sh all",
    "test:install": "tools/test-installed-system.sh bios && tools/test-installed-system.sh uefi",
    "yakumo": "node --expose-internals --import tsx --import @cordisjs/unyaml node_modules/yakumo/lib/cli.js",
    "build": "yarn yakumo esbuild && yarn yakumo tsc core loader && yarn yakumo tsc",
    "test": "vitest run --config vitest.config.ts",
    "test:text": "shx rm -rf coverage && yarn test --coverage --coverage.reporter text",
    "test:json": "shx rm -rf coverage && yarn test --coverage --coverage.reporter json",
    "test:html": "shx rm -rf coverage && yarn test --coverage --coverage.reporter html"
  },
  "devDependencies": {
    "@cordisjs/eslint-config": "^1.1.1",
    "@cordisjs/unyaml": "^2.0.3",
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.1",
    "shx": "^0.4.0",
    "tsx": "npm:@cordiverse/tsx@4.19.3-fix.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.5",
    "yakumo": "^3.2.1",
    "yakumo-esbuild": "^3.0.2",
    "yakumo-tsc": "^3.0.1",
    "yakumo-vitest": "^1.3.3"
  }
}
